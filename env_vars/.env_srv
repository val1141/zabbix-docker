# Minimal production-oriented Zabbix server settings.
ZBX_NODEADDRESS=zabbix-server:10051
ZBX_ENABLEGLOBALSCRIPTS=0
ZBX_ALLOWSOFTWAREUPDATECHECK=0
# Pollers and workers. Tune after checking internal Zabbix metrics.
ZBX_STARTPOLLERS=10
ZBX_STARTPOLLERSUNREACHABLE=2
ZBX_STARTPINGERS=2
ZBX_STARTDISCOVERERS=2
ZBX_STARTPREPROCESSORS=5
ZBX_STARTHTTPAGENTPOLLERS=2
ZBX_STARTSNMPPOLLERS=2
ZBX_STARTTRAPPERS=5
ZBX_STARTDBSYNCERS=4
ZBX_STARTESCALATORS=1
ZBX_STARTALERTERS=3
ZBX_STARTLLDPROCESSORS=2

# Caches for a small/medium VM. Increase when Zabbix reports cache pressure.
ZBX_CACHESIZE=256M
ZBX_HISTORYCACHESIZE=128M
ZBX_HISTORYINDEXCACHESIZE=64M
ZBX_TRENDCACHESIZE=128M
ZBX_TRENDFUNCTIONCACHESIZE=64M
ZBX_VALUECACHESIZE=256M

# Runtime timeouts and DB diagnostics.
ZBX_TIMEOUT=10
ZBX_TRAPPERTIMEOUT=300
ZBX_LOGSLOWQUERIES=3000

# Optional components are disabled in this deployment profile.
ZBX_STARTJAVAPOLLERS=0
ZBX_ENABLE_SNMP_TRAPS=false
ZBX_STARTREPORTWRITERS=0
ZBX_STARTBROWSERPOLLERS=0