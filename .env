# Production deployment profile for a single Zabbix VM.
# Target stack: Zabbix Server + Zabbix Web Nginx + PostgreSQL/TimescaleDB.

# Zabbix image selection.
OS=ubuntu
ZBX_VERSION=7.0
ZBX_IMAGE_REGISTRY=
ZBX_IMAGE_NAMESPACE=zabbix/
ZBX_IMAGE_TAG=${OS}-${ZBX_VERSION}-latest

ZABBIX_SERVER_PGSQL_IMAGE=${ZBX_IMAGE_REGISTRY}${ZBX_IMAGE_NAMESPACE}zabbix-server-pgsql
ZABBIX_WEB_NGINX_PGSQL_IMAGE=${ZBX_IMAGE_REGISTRY}${ZBX_IMAGE_NAMESPACE}zabbix-web-nginx-pgsql
ZABBIX_WEB_APACHE_PGSQL_IMAGE=${ZBX_IMAGE_REGISTRY}${ZBX_IMAGE_NAMESPACE}zabbix-web-apache-pgsql
ZABBIX_AGENT_IMAGE=${ZBX_IMAGE_REGISTRY}${ZBX_IMAGE_NAMESPACE}zabbix-agent
ZABBIX_AGENT2_IMAGE=${ZBX_IMAGE_REGISTRY}${ZBX_IMAGE_NAMESPACE}zabbix-agent2
ZABBIX_JAVA_GATEWAY_IMAGE=${ZBX_IMAGE_REGISTRY}${ZBX_IMAGE_NAMESPACE}zabbix-java-gateway
ZABBIX_SNMPTRAPS_IMAGE=${ZBX_IMAGE_REGISTRY}${ZBX_IMAGE_NAMESPACE}zabbix-snmptraps
ZABBIX_WEB_SERVICE_IMAGE=${ZBX_IMAGE_REGISTRY}${ZBX_IMAGE_NAMESPACE}zabbix-web-service

# Database images
MYSQL_IMAGE=mysql
MYSQL_IMAGE_TAG=8.4-oracle
POSTGRESQL_IMAGE=timescale/timescaledb
POSTGRESQL_IMAGE_TAG=2.18.1-pg17
#POSTGRESQL_IMAGE=postgres
#POSTGRESQL_IMAGE_TAG=17-alpine

# Database image selection. Keep this aligned with the supported Zabbix/PostgreSQL/TimescaleDB matrix.
POSTGRESQL_IMAGE=timescale/timescaledb
POSTGRESQL_IMAGE_TAG=2.18.1-pg17

# Published ports.
# 10051 must be reachable from active agents and proxies.
ZABBIX_SERVER_BIND_IP=0.0.0.0
ZABBIX_SERVER_PORT=10051
ZABBIX_SERVER_BIND_IP=0.0.0.0

# Web UI is intentionally bound to loopback. Put Nginx/Caddy/Traefik/VPN in front of it.
ZABBIX_WEB_NGINX_BIND_IP=127.0.0.1
ZABBIX_WEB_NGINX_HTTP_PORT=8080
ZABBIX_WEB_NGINX_HTTPS_PORT=8443

# Network IP ranges.
FRONTEND_NETWORK_DRIVER=default
FRONTEND_SUBNET=172.16.238.0/24
FRONTEND_ENABLE_IPV6=false
BACKEND_NETWORK_DRIVER=default
BACKEND_SUBNET=172.16.239.0/24
BACKEND_ENABLE_IPV6=false
DATABASE_NETWORK_DRIVER=default
DATABASE_NETWORK_ENABLE_IPV6=false

# Runtime data. In Proxmox, mount a dedicated virtual disk here.
DATA_DIRECTORY=/srv/zabbix
ENV_VARS_DIRECTORY=./env_vars
BACKUP_DIRECTORY=/srv/zabbix/backups

# Container restart policy.
RESTART_POLICY=unless-stopped
